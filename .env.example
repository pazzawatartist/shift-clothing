# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never
# import it into a Client Component. Used only by src/lib/supabase/admin.ts
# for admin-only operations (inviting/updating users via the Auth Admin API).
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the password-reset redirect link. Set to your deployed URL
# in production (e.g. https://shift-bms.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
